APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost
ALLOW_PUBLIC_REGISTRATION=false
ALLOW_BOOTSTRAP_SUPERADMIN_REGISTRATION=false
SUPERADMIN_EMAILS=
RISK_BENCHMARK_INDUSTRY_SCORE=12
RISK_BENCHMARK_TARGET_SCORE=9
RISK_BENCHMARK_SOURCE_NAME="NHSCFA Risk Management Guidance (public-sector 5x5 governance benchmark)"
RISK_BENCHMARK_SOURCE_REFERENCE="https://cfa.nhs.uk/about-nhscfa/information-hub/corporate-information-governance/risk-management-guidance (score 9+ discussion trigger; 12+ escalation threshold)"
RISK_BENCHMARK_SOURCE_YEAR=2022

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
# Recommended for production: CACHE_DRIVER=redis (requires Redis server + phpredis extension)
CACHE_DRIVER=file
# Recommended for production: QUEUE_CONNECTION=redis (requires Redis server)
QUEUE_CONNECTION=sync
# Recommended for production: SESSION_DRIVER=redis (requires Redis server)
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Redis Configuration (recommended for production performance)
# Uncomment and configure below when using Redis:
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
# PENTING: Set email pengirim untuk scheduled reports dan notifikasi sistem
MAIL_FROM_ADDRESS="noreply@yourcompany.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
NVD_API_KEY=
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
CISA_KEV_MIRROR_URL=https://raw.githubusercontent.com/cisagov/kev-data/develop/known_exploited_vulnerabilities.json
OWASP_TOP10_URL=https://owasp.org/Top10/
THREAT_INTEL_AUTO_REFRESH_ENABLED=true
THREAT_INTEL_AUTO_REFRESH_INTERVAL_MINUTES=30
THREAT_INTEL_AUTO_REFRESH_FORCE=true

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# OpenID Connect SSO (disabled by default; configure only in the target environment)
SSO_OIDC_ENABLED=false
SSO_OIDC_DISCOVERY_URL=
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
SSO_OIDC_REDIRECT_URI="${APP_URL}/sso/oidc/callback"
SSO_OIDC_SCOPES="openid profile email"
SSO_OIDC_SUBJECT_CLAIM=sub
SSO_OIDC_EMAIL_CLAIM=email
SSO_OIDC_NAME_CLAIM=name
SSO_OIDC_USERNAME_CLAIM=preferred_username
SSO_OIDC_DIVISION_CLAIM=department
SSO_OIDC_ALLOWED_EMAIL_DOMAINS=
SSO_OIDC_AUTO_PROVISION=false

# Signed external KRI ingestion (disabled by default)
KRI_INGESTION_ENABLED=false
KRI_INGESTION_SHARED_SECRET=
KRI_INGESTION_ALLOWED_SOURCES=
KRI_INGESTION_MAX_TIMESTAMP_SKEW_SECONDS=300
